{
  "expo": {
    "name": "VaultPace",
    "slug": "vaultpace-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0F19"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultpace.app",
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F8FAFC",
        "dark": {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F19"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.vaultpace.app",
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F8FAFC",
        "dark": {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F19"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0F19",
            "image": "./assets/icon.png",
            "resizeMode": "contain"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "62d18109-cdc0-4d0b-aeac-14167cb077f1"
      }
    },
    "owner": "dark0666"
  }
}
