{
  "expo": {
    "name": "VaultPace",
    "slug": "vaultpace-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultpace.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Allow VaultPace to access your contacts to select counterparties for debts and IOUs."
      },
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F8FAFC",
        "dark": {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.vaultpace.app",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F8FAFC",
        "dark": {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow VaultPace to access your contacts to link debts and IOUs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/icon.png",
            "imageWidth": 140,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableBundleCompression": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "62d18109-cdc0-4d0b-aeac-14167cb077f1"
      }
    },
    "owner": "dark0666"
  }
}