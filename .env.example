# ==============================================================================
# FundTracker Backend Environment Variables
# Copy to .env.local for local development. Never commit real keys.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Supabase / Neon / Local PostgreSQL)
DATABASE_URL=
DATABASE_DIRECT_URL=

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Payments (Test Mode keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=support@yourdomain.com

# Vercel Cron Secret (Secures scheduled background tasks)
CRON_SECRET=
